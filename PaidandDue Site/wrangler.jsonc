{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "paidanddue",

  "main": "./worker/index.js",

  "compatibility_date": "2026-10-07",

  "vars": {
    "SUPABASE_URL": "https://ttvdpgxqvvtjnxxfkoui.supabase.co"
  },

  "assets": {
    "directory": "./public"
  },

  "ratelimits": [
    {
      "name": "ACTIVATION_RATE_LIMITER",
      "namespace_id": "2026100701",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}